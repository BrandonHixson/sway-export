# Script outputs
*.pdf
*.docx

# ==========================================
# Dependencies
# ==========================================
node_modules/
jspm_packages/
.pnpm-store/
.yarn-integrity

# ==========================================
# TypeScript & Build Outputs
# ==========================================
# Ignore the folder where your compiled JS goes (usually 'dist' or 'build')
dist/
build/
out/

# TS build info cache
*.tsbuildinfo

# (Optional) If you emit JS files directly into your src/ folder, uncomment below:
# src/**/*.js
# src/**/*.js.map

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow an example template to be committed
!.env.example

# ==========================================
# Logs and Diagnostics
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/
.jest/

# ==========================================
# IDEs and Editors (VS Code)
# ==========================================
# Ignore workspace-specific states but KEEP shared tasks/settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Other common IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ==========================================
# System Files (OS specific)
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db